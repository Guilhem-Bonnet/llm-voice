{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-voice.dev/contracts/core-v1/http/ack.response.schema.json",
  "title": "Réponse générique — enqueue/play/pause/resume/stop/seek",
  "description": "Toutes les commandes HTTP hors `/health` répondent avec cette forme. `error` est obligatoire quand `ok` est faux.",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "ok"],
  "properties": {
    "protocolVersion": { "$ref": "../common.schema.json#/$defs/protocolVersion" },
    "ok": { "type": "boolean" },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "$ref": "../common.schema.json#/$defs/errorCode" },
        "message": { "type": "string", "minLength": 1 }
      }
    }
  },
  "if": {
    "properties": { "ok": { "const": false } },
    "required": ["ok"]
  },
  "then": {
    "required": ["error"]
  }
}
