{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "voice": {
      "type": "object",
      "properties": {
        "providerId": {
          "type": "string",
          "minLength": 1
        },
        "baseUrl": {
          "type": "string",
          "format": "uri"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "voice": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "type": "string",
          "minLength": 1
        },
        "apiKeyRef": {
          "type": "string",
          "minLength": 1,
          "pattern": "^llmVoice\\.apiKey\\.[A-Za-z0-9._@-]{1,64}$"
        },
        "parameters": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "referenceAudio": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\.(wav|mp3|flac|ogg|opus|m4a)$"
        },
        "speed": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 2
        }
      },
      "required": [
        "providerId",
        "speed"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "voice"
  ],
  "additionalProperties": false,
  "title": "LLM Voice — global-voice.json",
  "description": "Generated from src/core/profile.schema.ts (GlobalVoiceFileSchema); do not edit by hand."
}
