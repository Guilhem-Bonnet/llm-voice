{
  "name": "llm-voice",
  "displayName": "LLM Voice",
  "description": "Local-first voice narration for Markdown documents and LLM agent output (Claude Code, and more).",
  "version": "0.3.0",
  "publisher": "guilhem-bonnet",
  "license": "MIT",
  "private": true,
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Guilhem-Bonnet/llm-voice.git",
    "directory": "vscode-extension"
  },
  "bugs": {
    "url": "https://github.com/Guilhem-Bonnet/llm-voice/issues"
  },
  "homepage": "https://github.com/Guilhem-Bonnet/llm-voice/blob/main/vscode-extension/README.md",
  "qna": "marketplace",
  "engines": {
    "vscode": "^1.95.0",
    "node": ">=22"
  },
  "extensionKind": [
    "ui"
  ],
  "categories": [
    "Other"
  ],
  "keywords": [
    "tts",
    "text-to-speech",
    "voice",
    "narration",
    "accessibility",
    "markdown",
    "claude",
    "claude code",
    "local-first",
    "chatterbox",
    "piper"
  ],
  "galleryBanner": {
    "color": "#1E1E1E",
    "theme": "dark"
  },
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "jsonValidation": [
      {
        "fileMatch": "profiles.json",
        "url": "./schemas/profile-collection.schema.json"
      },
      {
        "fileMatch": "global-voice.json",
        "url": "./schemas/global-voice.schema.json"
      }
    ],
    "commands": [
      {
        "command": "llmVoice.speakDocument",
        "title": "LLM Voice: Lire le document",
        "category": "LLM Voice",
        "icon": "$(play)"
      },
      {
        "command": "llmVoice.chooseVoice",
        "title": "LLM Voice: Choisir la voix",
        "category": "LLM Voice"
      },
      {
        "command": "llmVoice.toggleCast",
        "title": "LLM Voice: Lire ce document à plusieurs voix (activer ou désactiver)",
        "category": "LLM Voice"
      },
      {
        "command": "llmVoice.chooseCastVoices",
        "title": "LLM Voice: Distribution, changer la voix d'un personnage",
        "category": "LLM Voice"
      },
      {
        "command": "llmVoice.openVoiceGallery",
        "title": "LLM Voice: Ouvrir la galerie de voix",
        "category": "LLM Voice",
        "icon": "$(list-selection)"
      },
      {
        "command": "llmVoice.chooseMode",
        "title": "LLM Voice: Choisir le mode",
        "category": "LLM Voice"
      },
      {
        "command": "llmVoice.setupVoice",
        "title": "LLM Voice: Setup Voice",
        "category": "LLM Voice"
      },
      {
        "command": "llmVoice.walkthroughOpenExample",
        "title": "LLM Voice: Open Walkthrough Example",
        "category": "LLM Voice"
      },
      {
        "command": "llmVoice.speakSelection",
        "title": "LLM Voice: Lire la sélection",
        "category": "LLM Voice"
      },
      {
        "command": "llmVoice.speakFromCursor",
        "title": "LLM Voice: Lire à partir d'ici",
        "category": "LLM Voice"
      },
      {
        "command": "llmVoice.speakSection",
        "title": "LLM Voice: Lire la section",
        "category": "LLM Voice"
      },
      {
        "command": "llmVoice.speakClipboard",
        "title": "LLM Voice: Speak Clipboard",
        "category": "LLM Voice"
      },
      {
        "command": "llmVoice.play",
        "title": "LLM Voice: Play",
        "category": "LLM Voice"
      },
      {
        "command": "llmVoice.playPause",
        "title": "LLM Voice: Play/Pause",
        "category": "LLM Voice"
      },
      {
        "command": "llmVoice.pause",
        "title": "LLM Voice: Pause",
        "category": "LLM Voice",
        "enablement": "llmVoice.state == 'playing'"
      },
      {
        "command": "llmVoice.stop",
        "title": "LLM Voice: Stop",
        "category": "LLM Voice",
        "enablement": "llmVoice.state != 'idle'"
      },
      {
        "command": "llmVoice.previousSegment",
        "title": "LLM Voice: Previous Segment",
        "category": "LLM Voice",
        "enablement": "llmVoice.state != 'idle'"
      },
      {
        "command": "llmVoice.nextSegment",
        "title": "LLM Voice: Next Segment",
        "category": "LLM Voice",
        "enablement": "llmVoice.state != 'idle'"
      },
      {
        "command": "llmVoice.selectProfile",
        "title": "LLM Voice: Select Profile",
        "category": "LLM Voice"
      },
      {
        "command": "llmVoice.openProfiles",
        "title": "LLM Voice: Open Profiles",
        "category": "LLM Voice"
      },
      {
        "command": "llmVoice.duplicateProfile",
        "title": "LLM Voice: Duplicate Profile",
        "category": "LLM Voice"
      },
      {
        "command": "llmVoice.deleteProfile",
        "title": "LLM Voice: Delete Profile",
        "category": "LLM Voice"
      },
      {
        "command": "llmVoice.importProfile",
        "title": "LLM Voice: Import Profile",
        "category": "LLM Voice"
      },
      {
        "command": "llmVoice.exportProfile",
        "title": "LLM Voice: Export Profile",
        "category": "LLM Voice"
      },
      {
        "command": "llmVoice.setDefaultProfile",
        "title": "LLM Voice: Set Default Profile",
        "category": "LLM Voice"
      },
      {
        "command": "llmVoice.testVoice",
        "title": "LLM Voice: Test Voice",
        "category": "LLM Voice"
      },
      {
        "command": "llmVoice.providerStatus",
        "title": "LLM Voice: Provider Status",
        "category": "LLM Voice"
      },
      {
        "command": "llmVoice.performanceReport",
        "title": "LLM Voice: Show Performance Report",
        "category": "LLM Voice"
      },
      {
        "command": "llmVoice.setProviderApiKey",
        "title": "LLM Voice: Set Provider API Key",
        "category": "LLM Voice"
      },
      {
        "command": "llmVoice.clearProviderApiKey",
        "title": "LLM Voice: Clear Provider API Key",
        "category": "LLM Voice"
      },
      {
        "command": "llmVoice.openInbox",
        "title": "LLM Voice: Ouvrir les réponses",
        "category": "LLM Voice"
      },
      {
        "command": "llmVoice.speakLatestResponse",
        "title": "LLM Voice: Lire la dernière réponse",
        "category": "LLM Voice",
        "icon": "$(play)"
      },
      {
        "command": "llmVoice.speakLatestClaudeResponse",
        "title": "LLM Voice: Lire la dernière réponse",
        "category": "LLM Voice"
      },
      {
        "command": "llmVoice.clearHighlight",
        "title": "LLM Voice: Clear Highlight",
        "category": "LLM Voice"
      },
      {
        "command": "llmVoice.clearAudioCache",
        "title": "LLM Voice: Clear Audio Cache",
        "category": "LLM Voice"
      },
      {
        "command": "llmVoice.verifyLocalMode",
        "title": "LLM Voice: Verify Local Mode",
        "category": "LLM Voice"
      },
      {
        "command": "llmVoice.installClaudeHook",
        "title": "LLM Voice: Install Claude Hook",
        "category": "LLM Voice"
      },
      {
        "command": "llmVoice.uninstallClaudeHook",
        "title": "LLM Voice: Uninstall Claude Hook",
        "category": "LLM Voice"
      },
      {
        "command": "llmVoice.installPiperVoice",
        "title": "LLM Voice: Install Local Voice (Piper)",
        "category": "LLM Voice"
      },
      {
        "command": "llmVoice.browseVoices",
        "title": "LLM Voice: Ouvrir la galerie de voix",
        "category": "LLM Voice",
        "icon": "$(list-selection)"
      },
      {
        "command": "llmVoice.openSettings",
        "title": "LLM Voice: Open Settings",
        "category": "LLM Voice",
        "icon": "$(gear)"
      },
      {
        "command": "llmVoice.useOwnVoice",
        "title": "LLM Voice: Use My Own Voice",
        "category": "LLM Voice"
      },
      {
        "command": "llmVoice.editProfile",
        "title": "LLM Voice: Edit Profile",
        "category": "LLM Voice"
      },
      {
        "command": "llmVoice.statusBar.openMenu",
        "title": "LLM Voice: Status Bar Menu",
        "category": "LLM Voice"
      },
      {
        "command": "llmVoice.inbox.refresh",
        "title": "LLM Voice: Actualiser les réponses",
        "category": "LLM Voice",
        "icon": "$(refresh)"
      },
      {
        "command": "llmVoice.inbox.speak",
        "title": "LLM Voice: Lire cette réponse",
        "category": "LLM Voice",
        "icon": "$(play)"
      },
      {
        "command": "llmVoice.inbox.openFull",
        "title": "LLM Voice: Ouvrir le texte de cette réponse",
        "category": "LLM Voice",
        "icon": "$(eye)"
      },
      {
        "command": "llmVoice.inbox.delete",
        "title": "LLM Voice: Supprimer cette réponse",
        "category": "LLM Voice",
        "icon": "$(trash)"
      },
      {
        "command": "llmVoice.inbox.markRead",
        "title": "LLM Voice: Marquer cette réponse comme lue ou non lue",
        "category": "LLM Voice",
        "icon": "$(check)"
      },
      {
        "command": "llmVoice.profilesView.new",
        "title": "LLM Voice: New Profile",
        "category": "LLM Voice",
        "icon": "$(add)"
      },
      {
        "command": "llmVoice.profilesView.activate",
        "title": "LLM Voice: Activate Profile",
        "category": "LLM Voice",
        "icon": "$(check)"
      },
      {
        "command": "llmVoice.profilesView.edit",
        "title": "LLM Voice: Edit Profile",
        "category": "LLM Voice",
        "icon": "$(edit)"
      },
      {
        "command": "llmVoice.profilesView.duplicate",
        "title": "LLM Voice: Duplicate Profile",
        "category": "LLM Voice",
        "icon": "$(copy)"
      },
      {
        "command": "llmVoice.profilesView.delete",
        "title": "LLM Voice: Delete Profile",
        "category": "LLM Voice",
        "icon": "$(trash)"
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "llm-voice-panel",
          "title": "LLM Voice",
          "icon": "media/player-icon.svg"
        }
      ],
      "activitybar": [
        {
          "id": "llmVoice",
          "title": "LLM Voice",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "views": {
      "llm-voice-panel": [
        {
          "type": "webview",
          "id": "llmVoice.player",
          "name": "Player"
        }
      ],
      "llmVoice": [
        {
          "type": "webview",
          "id": "llmVoice.playerView",
          "name": "Lecture en cours",
          "when": "config.llmVoice.ui.layout == full"
        },
        {
          "type": "webview",
          "id": "llmVoice.inboxView",
          "name": "Réponses",
          "when": "config.llmVoice.ui.layout == full"
        },
        {
          "id": "llmVoice.profilesView",
          "name": "Modes",
          "when": "config.llmVoice.ui.layout == full"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "llmVoice.player",
        "contents": "Aucune lecture en cours.\n[Choisir une voix](command:llmVoice.setupVoice)\n[Lire le document actuel](command:llmVoice.speakDocument)"
      },
      {
        "view": "llmVoice.playerView",
        "contents": "Aucune lecture en cours.\n[Lire le document actuel](command:llmVoice.speakDocument)\n[Choisir une voix](command:llmVoice.setupVoice)"
      }
    ],
    "submenus": [
      {
        "id": "llmVoice.markdownContextMenu",
        "label": "Lire à voix haute"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "llmVoice.setupVoice",
          "when": "false"
        },
        {
          "command": "llmVoice.browseVoices",
          "when": "false"
        },
        {
          "command": "llmVoice.selectProfile",
          "when": "false"
        },
        {
          "command": "llmVoice.statusBar.openMenu",
          "when": "false"
        },
        {
          "command": "llmVoice.walkthroughOpenExample",
          "when": "false"
        },
        {
          "command": "llmVoice.speakLatestClaudeResponse",
          "when": "false"
        },
        {
          "command": "llmVoice.inbox.speak",
          "when": "false"
        },
        {
          "command": "llmVoice.inbox.openFull",
          "when": "false"
        },
        {
          "command": "llmVoice.inbox.delete",
          "when": "false"
        },
        {
          "command": "llmVoice.inbox.markRead",
          "when": "false"
        },
        {
          "command": "llmVoice.profilesView.activate",
          "when": "false"
        },
        {
          "command": "llmVoice.profilesView.edit",
          "when": "false"
        },
        {
          "command": "llmVoice.profilesView.duplicate",
          "when": "false"
        },
        {
          "command": "llmVoice.profilesView.delete",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "submenu": "llmVoice.markdownContextMenu",
          "when": "editorTextFocus",
          "group": "llmVoice"
        }
      ],
      "llmVoice.markdownContextMenu": [
        {
          "command": "llmVoice.speakSelection",
          "when": "editorHasSelection",
          "group": "1_speak@1"
        },
        {
          "command": "llmVoice.speakFromCursor",
          "group": "1_speak@2"
        },
        {
          "command": "llmVoice.speakSection",
          "when": "resourceLangId == markdown",
          "group": "1_speak@3"
        },
        {
          "command": "llmVoice.speakDocument",
          "group": "1_speak@4"
        }
      ],
      "editor/title": [
        {
          "command": "llmVoice.speakDocument",
          "when": "resourceLangId || activeWebviewPanelId == 'markdown.preview'",
          "group": "navigation"
        }
      ],
      "webview/context": [
        {
          "command": "llmVoice.speakDocument",
          "when": "webviewId == 'markdown.preview'",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "llmVoice.inbox.refresh",
          "when": "view == llmVoice.inboxView",
          "group": "navigation"
        },
        {
          "command": "llmVoice.speakDocument",
          "when": "view == llmVoice.playerView",
          "group": "navigation@1"
        },
        {
          "command": "llmVoice.browseVoices",
          "when": "view == llmVoice.playerView",
          "group": "navigation@2"
        },
        {
          "command": "llmVoice.openSettings",
          "when": "view == llmVoice.playerView",
          "group": "navigation@3"
        },
        {
          "command": "llmVoice.profilesView.new",
          "when": "view == llmVoice.profilesView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "llmVoice.profilesView.activate",
          "when": "view == llmVoice.profilesView && viewItem == llmVoiceProfileEntry",
          "group": "inline@1"
        },
        {
          "command": "llmVoice.profilesView.edit",
          "when": "view == llmVoice.profilesView && viewItem == llmVoiceProfileEntry",
          "group": "inline@2"
        },
        {
          "command": "llmVoice.profilesView.duplicate",
          "when": "view == llmVoice.profilesView && viewItem == llmVoiceProfileEntry",
          "group": "inline@3"
        },
        {
          "command": "llmVoice.profilesView.delete",
          "when": "view == llmVoice.profilesView && viewItem == llmVoiceProfileEntry",
          "group": "inline@4"
        }
      ]
    },
    "keybindings": [
      {
        "key": "ctrl+alt+v d",
        "command": "llmVoice.speakDocument",
        "when": "editorTextFocus && !terminalFocus"
      },
      {
        "key": "ctrl+alt+v s",
        "command": "llmVoice.speakSelection",
        "when": "editorTextFocus && editorHasSelection && !terminalFocus"
      },
      {
        "key": "ctrl+alt+v f",
        "command": "llmVoice.speakFromCursor",
        "when": "editorTextFocus && !terminalFocus"
      },
      {
        "key": "ctrl+alt+v t",
        "command": "llmVoice.speakSection",
        "when": "editorTextFocus && editorLangId == markdown && !terminalFocus"
      },
      {
        "key": "ctrl+alt+v c",
        "command": "llmVoice.speakClipboard",
        "when": "!terminalFocus"
      },
      {
        "key": "ctrl+alt+v r",
        "command": "llmVoice.speakLatestResponse"
      },
      {
        "key": "ctrl+alt+v space",
        "command": "llmVoice.playPause",
        "when": "!terminalFocus"
      },
      {
        "key": "ctrl+alt+v x",
        "command": "llmVoice.stop",
        "when": "!terminalFocus"
      },
      {
        "key": "ctrl+alt+v n",
        "command": "llmVoice.nextSegment",
        "when": "!terminalFocus"
      },
      {
        "key": "ctrl+alt+v p",
        "command": "llmVoice.previousSegment",
        "when": "!terminalFocus"
      }
    ],
    "configuration": {
      "title": "LLM Voice",
      "properties": {
        "llmVoice.modes.bySource": {
          "type": "object",
          "default": {
            "claude-code": "faithful-local"
          },
          "description": "Mode de lecture selon la source : markdown, text (sélection), clipboard, claude-code. Une source non renseignée utilise le dernier mode choisi. Une source choisit un mode, jamais une voix.",
          "properties": {
            "markdown": {
              "type": "string",
              "description": "Mode pour un document Markdown."
            },
            "text": {
              "type": "string",
              "description": "Mode pour une sélection de texte."
            },
            "clipboard": {
              "type": "string",
              "description": "Mode pour le presse-papiers."
            },
            "claude-code": {
              "type": "string",
              "description": "Mode pour les réponses, quel que soit l'outil."
            }
          },
          "additionalProperties": false
        },
        "llmVoice.profiles.bySource": {
          "type": "object",
          "deprecationMessage": "Remplacé par llmVoice.modes.bySource. Ce réglage reste lu tant que le nouveau n'est pas défini.",
          "default": {
            "claude-code": "faithful-local"
          },
          "description": "Profil par défaut selon la source de capture (CdC §47) : markdown, text (sélection), clipboard, claude-code. Une source non renseignée utilise le dernier profil sélectionné.",
          "properties": {
            "markdown": {
              "type": "string",
              "description": "Profil par défaut pour un document Markdown."
            },
            "text": {
              "type": "string",
              "description": "Profil par défaut pour une sélection de texte."
            },
            "clipboard": {
              "type": "string",
              "description": "Profil par défaut pour le presse-papiers."
            },
            "claude-code": {
              "type": "string",
              "description": "Profil par défaut pour les réponses."
            }
          },
          "additionalProperties": false
        },
        "llmVoice.testVoice.text": {
          "type": "string",
          "default": "Bonjour. Voici un exemple de ma voix. Nous allons maintenant examiner un concept technique et voir comment l'expliquer clairement.",
          "description": "Texte de référence lu par « LLM Voice: Test Voice » (CdC §50)."
        },
        "llmVoice.tts.baseUrl": {
          "type": "string",
          "deprecationMessage": "L'adresse appartient à la voix : « Choisir la voix ». Ce réglage ne sert plus qu'à une voix propre sans adresse.",
          "default": "http://127.0.0.1:8004",
          "description": "URL de base du service de synthèse vocale (TTS), doit rester locale par défaut (D2, D10). Port 8004 = Chatterbox (ADR-009 niveau 1). Kokoro utilise le port 8880 tant que ce réglage reste vide ou sur le port de Chatterbox."
        },
        "llmVoice.tts.provider": {
          "type": "string",
          "deprecationMessage": "Le moteur appartient à la voix : « Choisir la voix ». Ce réglage ne sert plus qu'à une voix propre sans moteur.",
          "default": "auto",
          "enum": [
            "auto",
            "chatterbox",
            "kokoro",
            "piper-local",
            "system",
            "openai-compatible"
          ],
          "enumDescriptions": [
            "Sélection automatique (S7.1, ADR-009) : Chatterbox si disponible, sinon Piper local, sinon la voix système — zéro configuration.",
            "Chatterbox (niveau 1, GPU, port 8004 par défaut).",
            "Kokoro (niveau 1, repli léger, port 8880 par défaut).",
            "Piper derrière un serveur compatible OpenAI (niveau 1b, port 5000 par défaut).",
            "Voix système sans installation ni serveur — espeak-ng/Piper local/say/SAPI selon la plateforme (niveau 1b, ADR-009).",
            "Point de terminaison compatible OpenAI générique (entreprise/cloud, niveaux 2-3)."
          ],
          "description": "Identifiant du provider TTS utilisé (provider agnostic, CdC §3.3). « auto » (défaut) ne nécessite aucune installation. Voir docs/providers.md."
        },
        "llmVoice.narrator.provider": {
          "type": "string",
          "default": "",
          "description": "Identifiant du provider de narration (LLM local), vide = lecture fidèle uniquement."
        },
        "llmVoice.narrator.baseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:11434",
          "description": "URL de base du service de narration (LLM local, ex. Ollama)."
        },
        "llmVoice.narrator.model": {
          "type": "string",
          "default": "qwen2.5:7b",
          "description": "Nom du modèle utilisé par le provider de narration (défaut : qwen2.5:7b, un compromis raisonnable taille/fiabilité en sortie structurée avec Ollama, CdC §21)."
        },
        "llmVoice.narrator.timeoutMs": {
          "type": "number",
          "default": 60000,
          "minimum": 1000,
          "description": "Délai maximal (ms) d'une requête de narration avant annulation, combiné au signal utilisateur (Stop). CdC §52/résilience."
        },
        "llmVoice.tts.timeoutMs": {
          "type": "number",
          "default": 60000,
          "minimum": 1000,
          "description": "Délai maximal (ms) d'une requête de synthèse vocale avant annulation, combiné au signal utilisateur (Stop). CdC §52/résilience."
        },
        "llmVoice.tts.readyTimeoutMs": {
          "type": "number",
          "default": 180000,
          "minimum": 0,
          "description": "Délai maximal (ms) d'attente d'un provider TTS en statut « Loading » (CdC §51) avant la première synthèse, plutôt que d'échouer immédiatement. 0 = aucune attente."
        },
        "llmVoice.audio.engine": {
          "type": "string",
          "enum": [
            "webview",
            "native"
          ],
          "default": "webview",
          "description": "Moteur de lecture audio (ADR-012). « webview » (défaut à ce stade) joue via l'élément <audio> du mini-lecteur, sur clic (repli explicite, ADR-001). « native » joue via le démon local `llm-voice-core` (Rust), sans geste utilisateur requis ; bascule du défaut prévue par une carte ultérieure une fois le moteur natif validé en conditions réelles."
        },
        "llmVoice.audio.corePath": {
          "type": "string",
          "default": "",
          "description": "Chemin absolu vers le binaire `llm-voice-core` (ADR-012 §5), pour remplacer la résolution par défaut (`<extension>/bin/<plateforme>/llm-voice-core`, puis `target/release/llm-voice-core` en développement). Vide = résolution automatique. Sans effet si `llmVoice.audio.engine` n'est pas « native »."
        },
        "llmVoice.audio.maxRetries": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "description": "Nombre de nouvelles tentatives avant qu'un chunk audio invalide déclenche le choix Skip / Stop (CdC §52)."
        },
        "llmVoice.audio.prefetchChunks": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "maximum": 10,
          "description": "Nombre de chunks audio pré-synthétisés en avance (CdC §32). 2 convient tant que le facteur temps réel (RTF) du provider TTS reste ≈ 1 — voir docs/performance.md."
        },
        "llmVoice.audio.firstChunkSentences": {
          "type": "number",
          "default": 1,
          "minimum": 1,
          "maximum": 10,
          "description": "Nombre de phrases du tout premier chunk audio d'un document, avant la taille normale du profil (CdC §63 : la lecture doit démarrer dès le premier chunk). Sans effet si ≥ à la taille de chunk du profil."
        },
        "llmVoice.tts.warmup": {
          "type": "boolean",
          "default": true,
          "description": "Préchauffe le provider TTS (health() + courte synthèse jetable) dès la première résolution du provider, en tâche de fond, pour absorber le cold start (compilation GPU) hors du chemin critique d'une vraie lecture."
        },
        "llmVoice.highlight.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Active le surlignage du segment en cours de lecture dans l'éditeur (ADR-002)."
        },
        "llmVoice.highlight.mode": {
          "type": "string",
          "enum": [
            "sentence",
            "block"
          ],
          "default": "sentence",
          "description": "Granularité du surlignage : phrase (lecture fidèle) ou bloc (narration transformée, CdC §15)."
        },
        "llmVoice.codeLens.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Affiche un CodeLens « ▶ Lire cette section » au-dessus de chaque titre Markdown (CdC §69)."
        },
        "llmVoice.cache.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Active le cache disque des fichiers audio synthétisés."
        },
        "llmVoice.cache.maxSizeMb": {
          "type": "number",
          "default": 512,
          "minimum": 0,
          "description": "Taille maximale du cache audio en mégaoctets."
        },
        "llmVoice.responses.readCode": {
          "type": "boolean",
          "default": false,
          "description": "Lit les blocs de code d'une réponse, langage annoncé, au lieu de dire « un exemple de code ». La puce du panneau change ce choix pour la session, à partir de la lecture suivante."
        },
        "llmVoice.claude.inboxPath": {
          "type": "string",
          "default": "",
          "description": "Dossier des réponses capturées, quel que soit l'outil qui les dépose."
        },
        "llmVoice.claude.captureEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Active la capture automatique des réponses Claude Code via le hook Stop."
        },
        "llmVoice.privacy.localOnly": {
          "type": "boolean",
          "default": true,
          "description": "N'autorise que des providers locaux (loopback) ; toute cible réseau distante est refusée (D10, ADR-009)."
        },
        "llmVoice.network.trustedHosts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Hôtes explicitement autorisés lorsque `privacy.localOnly` est désactivé."
        },
        "llmVoice.ui.layout": {
          "type": "string",
          "enum": [
            "minimal",
            "full"
          ],
          "default": "full",
          "description": "`full` (défaut depuis la révision du 2026-09-12) : icône dédiée dans la barre d'activité + View Container complet (Lecture en cours, Réponses, Modes), point d'entrée principal. `minimal` : status bar + Panel + CodeLens uniquement, pour qui préfère le lecteur dans le panneau (ADR-011)."
        },
        "llmVoice.privacy.telemetryEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Active la télémétrie d'usage. Désactivée par défaut."
        },
        "llmVoice.log.level": {
          "type": "string",
          "enum": [
            "error",
            "warn",
            "info",
            "debug"
          ],
          "default": "info",
          "description": "Niveau de journalisation de l'Output Channel « LLM Voice » (CdC §81). Aucun niveau ne journalise de clé API, contenu de document, réponse Claude ou audio (AC-SEC-07)."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "llmVoice.gettingStarted",
        "title": "Démarrer avec LLM Voice",
        "description": "Lisez vos documents Markdown et les réponses de vos agents LLM à voix haute, 100 % en local — quatre étapes pour être opérationnel. Point de départ : l'icône LLM Voice de la barre d'activité (ou le raccourci Ctrl+Alt+V).",
        "steps": [
          {
            "id": "chooseVoice",
            "title": "Choisir une voix",
            "description": "LLM Voice fonctionne dès l'installation avec la voix de votre système, sans rien installer. Si aucune voix locale n'est encore installée, le premier « Speak » propose de télécharger la voix française autonome (~60 Mo, une fois, aucun Docker). Le niveau « Qualité maximale » (clonage de voix) reste disponible en option, mais nécessite Docker.\n[Choisir une voix](command:llmVoice.setupVoice)",
            "media": {
              "image": "media/walkthrough/choose-voice.svg",
              "altText": "Trois niveaux de voix : système, Piper, Chatterbox"
            },
            "completionEvents": [
              "onCommand:llmVoice.setupVoice"
            ]
          },
          {
            "id": "readDocument",
            "title": "Lire un document",
            "description": "Ouvrez un fichier Markdown et lancez la lecture : le segment en cours de lecture est surligné dans l'éditeur, et les contrôles de lecture apparaissent dans « Lecture en cours » (icône LLM Voice de la barre d'activité).\n[Ouvrir l'exemple et lire](command:llmVoice.walkthroughOpenExample)",
            "media": {
              "image": "media/walkthrough/read-document.svg",
              "altText": "Un document Markdown lu à voix haute, segment surligné"
            },
            "completionEvents": [
              "onCommand:llmVoice.speakDocument"
            ]
          },
          {
            "id": "chooseProfile",
            "title": "Choisir un mode",
            "description": "Un mode fixe la façon de lire le texte, la voix reste celle que vous avez choisie. Quatre modes sont fournis : Fidèle, Professeur, Résumé, Révision.\n[Choisir un mode](command:llmVoice.chooseMode)",
            "media": {
              "image": "media/walkthrough/choose-profile.svg",
              "altText": "Quatre modes de lecture au choix"
            },
            "completionEvents": [
              "onCommand:llmVoice.chooseMode"
            ]
          },
          {
            "id": "connectClaude",
            "title": "Optionnel : connecter un outil",
            "description": "Capturez automatiquement les réponses d'un outil dans la liste Réponses, et écoutez-les au lieu de les lire. Aujourd'hui : Claude Code.\n[Connecter un outil](command:llmVoice.installClaudeHook)",
            "media": {
              "image": "media/walkthrough/connect-claude.svg",
              "altText": "Réponses capturées dans la liste Réponses"
            },
            "completionEvents": [
              "onCommand:llmVoice.installClaudeHook"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./ --noEmit false --outDir out",
    "watch": "tsc -p ./ --watch",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p ./ --noEmit",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration-real": "vitest run --config vitest.integration-real.config.ts",
    "test:integration-security": "npm run build && vscode-test --label integration-security",
    "test:integration-voice": "npm run build && xvfb-run -a vscode-test --label voice-chain",
    "bundle": "node scripts/esbuild.mjs",
    "generate:icon": "node scripts/generate-icon.mjs",
    "generate:profile-schema": "node scripts/generate-profile-schema.mjs",
    "gen:schema": "npm run generate:profile-schema",
    "copy:claude-integration": "node scripts/copy-claude-integration.mjs",
    "sync:changelog": "node scripts/sync-changelog.mjs",
    "build": "npm run compile && npm run generate:profile-schema && npm run copy:claude-integration && npm run bundle",
    "test:integration": "npm run build && vscode-test",
    "e2e:local": "bash ../scripts/e2e-local-suite.sh",
    "package": "npm run generate:icon && npm run sync:changelog && npm run build && vsce package --no-dependencies -o llm-voice.vsix && node scripts/check-vsix.mjs",
    "build:core:linux-x64": "cargo build --release -p llm-voice-core --manifest-path ../Cargo.toml",
    "stage:core:linux-x64": "node scripts/stage-core.mjs linux-x64",
    "package:linux-x64": "npm run generate:icon && npm run sync:changelog && npm run build && npm run build:core:linux-x64 && npm run stage:core:linux-x64 && vsce package --no-dependencies --target linux-x64 -o llm-voice-linux-x64.vsix && npm run check:vsix:linux-x64",
    "vscode:prepublish": "npm run build",
    "check:audit": "npm audit --omit=dev --audit-level=high",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:vsix": "npm run build && node scripts/check-vsix.mjs",
    "check:vsix:linux-x64": "node scripts/check-vsix.mjs --target linux-x64",
    "check:security": "npm run check:audit && npm run check:licenses && npm run check:vsix"
  },
  "dependencies": {
    "mdast-util-to-string": "^4.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.2",
    "@types/unist": "^3.0.3",
    "@types/vscode": "^1.95.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitest/coverage-v8": "^5.0.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.2.1",
    "ajv": "^8.17.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "typescript": "^5.7.2",
    "vitest": "^5.0.0"
  }
}
