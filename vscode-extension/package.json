{
  "name": "llm-voice",
  "displayName": "LLM Voice",
  "description": "Local-first voice narration for Markdown documents and LLM agent output (Claude Code, and more).",
  "version": "0.1.1",
  "publisher": "guilhem-bonnet",
  "license": "MIT",
  "private": true,
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Guilhem-Bonnet/llm-voice.git",
    "directory": "vscode-extension"
  },
  "bugs": {
    "url": "https://github.com/Guilhem-Bonnet/llm-voice/issues"
  },
  "homepage": "https://github.com/Guilhem-Bonnet/llm-voice/blob/main/vscode-extension/README.md",
  "qna": "marketplace",
  "engines": {
    "vscode": "^1.95.0",
    "node": ">=22"
  },
  "extensionKind": [
    "ui"
  ],
  "categories": [
    "Other"
  ],
  "keywords": [
    "tts",
    "text-to-speech",
    "voice",
    "narration",
    "accessibility",
    "markdown",
    "claude",
    "claude code",
    "local-first",
    "chatterbox",
    "piper"
  ],
  "galleryBanner": {
    "color": "#1E1E1E",
    "theme": "dark"
  },
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "jsonValidation": [
      {
        "fileMatch": "profiles.json",
        "url": "./schemas/profile-collection.schema.json"
      }
    ],
    "commands": [
      {
        "command": "llmVoice.speakDocument",
        "title": "LLM Voice: Speak Document",
        "category": "LLM Voice",
        "icon": "$(unmute)"
      },
      {
        "command": "llmVoice.setupVoice",
        "title": "LLM Voice: Setup Voice",
        "category": "LLM Voice"
      },
      {
        "command": "llmVoice.walkthroughOpenExample",
        "title": "LLM Voice: Open Walkthrough Example",
        "category": "LLM Voice"
      },
      {
        "command": "llmVoice.speakSelection",
        "title": "LLM Voice: Speak Selection",
        "category": "LLM Voice"
      },
      {
        "command": "llmVoice.speakFromCursor",
        "title": "LLM Voice: Speak From Cursor",
        "category": "LLM Voice"
      },
      {
        "command": "llmVoice.speakSection",
        "title": "LLM Voice: Speak Section",
        "category": "LLM Voice"
      },
      {
        "command": "llmVoice.speakClipboard",
        "title": "LLM Voice: Speak Clipboard",
        "category": "LLM Voice"
      },
      {
        "command": "llmVoice.play",
        "title": "LLM Voice: Play",
        "category": "LLM Voice"
      },
      {
        "command": "llmVoice.playPause",
        "title": "LLM Voice: Play/Pause",
        "category": "LLM Voice"
      },
      {
        "command": "llmVoice.pause",
        "title": "LLM Voice: Pause",
        "category": "LLM Voice",
        "enablement": "llmVoice.state == 'playing'"
      },
      {
        "command": "llmVoice.stop",
        "title": "LLM Voice: Stop",
        "category": "LLM Voice",
        "enablement": "llmVoice.state != 'idle'"
      },
      {
        "command": "llmVoice.previousSegment",
        "title": "LLM Voice: Previous Segment",
        "category": "LLM Voice",
        "enablement": "llmVoice.state != 'idle'"
      },
      {
        "command": "llmVoice.nextSegment",
        "title": "LLM Voice: Next Segment",
        "category": "LLM Voice",
        "enablement": "llmVoice.state != 'idle'"
      },
      {
        "command": "llmVoice.selectProfile",
        "title": "LLM Voice: Select Profile",
        "category": "LLM Voice"
      },
      {
        "command": "llmVoice.openProfiles",
        "title": "LLM Voice: Open Profiles",
        "category": "LLM Voice"
      },
      {
        "command": "llmVoice.duplicateProfile",
        "title": "LLM Voice: Duplicate Profile",
        "category": "LLM Voice"
      },
      {
        "command": "llmVoice.deleteProfile",
        "title": "LLM Voice: Delete Profile",
        "category": "LLM Voice"
      },
      {
        "command": "llmVoice.importProfile",
        "title": "LLM Voice: Import Profile",
        "category": "LLM Voice"
      },
      {
        "command": "llmVoice.exportProfile",
        "title": "LLM Voice: Export Profile",
        "category": "LLM Voice"
      },
      {
        "command": "llmVoice.setDefaultProfile",
        "title": "LLM Voice: Set Default Profile",
        "category": "LLM Voice"
      },
      {
        "command": "llmVoice.testVoice",
        "title": "LLM Voice: Test Voice",
        "category": "LLM Voice"
      },
      {
        "command": "llmVoice.providerStatus",
        "title": "LLM Voice: Provider Status",
        "category": "LLM Voice"
      },
      {
        "command": "llmVoice.performanceReport",
        "title": "LLM Voice: Show Performance Report",
        "category": "LLM Voice"
      },
      {
        "command": "llmVoice.setProviderApiKey",
        "title": "LLM Voice: Set Provider API Key",
        "category": "LLM Voice"
      },
      {
        "command": "llmVoice.clearProviderApiKey",
        "title": "LLM Voice: Clear Provider API Key",
        "category": "LLM Voice"
      },
      {
        "command": "llmVoice.openInbox",
        "title": "LLM Voice: Open Inbox",
        "category": "LLM Voice"
      },
      {
        "command": "llmVoice.speakLatestClaudeResponse",
        "title": "LLM Voice: Speak Latest Claude Response",
        "category": "LLM Voice"
      },
      {
        "command": "llmVoice.clearHighlight",
        "title": "LLM Voice: Clear Highlight",
        "category": "LLM Voice"
      },
      {
        "command": "llmVoice.clearAudioCache",
        "title": "LLM Voice: Clear Audio Cache",
        "category": "LLM Voice"
      },
      {
        "command": "llmVoice.verifyLocalMode",
        "title": "LLM Voice: Verify Local Mode",
        "category": "LLM Voice"
      },
      {
        "command": "llmVoice.installClaudeHook",
        "title": "LLM Voice: Install Claude Hook",
        "category": "LLM Voice"
      },
      {
        "command": "llmVoice.uninstallClaudeHook",
        "title": "LLM Voice: Uninstall Claude Hook",
        "category": "LLM Voice"
      },
      {
        "command": "llmVoice.installPiperVoice",
        "title": "LLM Voice: Install Local Voice (Piper)",
        "category": "LLM Voice"
      },
      {
        "command": "llmVoice.browseVoices",
        "title": "LLM Voice: Browse Voices",
        "category": "LLM Voice"
      },
      {
        "command": "llmVoice.useOwnVoice",
        "title": "LLM Voice: Use My Own Voice",
        "category": "LLM Voice"
      },
      {
        "command": "llmVoice.editProfile",
        "title": "LLM Voice: Edit Profile",
        "category": "LLM Voice"
      },
      {
        "command": "llmVoice.statusBar.openMenu",
        "title": "LLM Voice: Status Bar Menu",
        "category": "LLM Voice"
      },
      {
        "command": "llmVoice.inbox.refresh",
        "title": "LLM Voice: Refresh Inbox",
        "category": "LLM Voice",
        "icon": "$(refresh)"
      },
      {
        "command": "llmVoice.inbox.speak",
        "title": "LLM Voice: Speak Inbox Message",
        "category": "LLM Voice",
        "icon": "$(play)"
      },
      {
        "command": "llmVoice.inbox.openFull",
        "title": "LLM Voice: Open Full Response",
        "category": "LLM Voice",
        "icon": "$(eye)"
      },
      {
        "command": "llmVoice.inbox.delete",
        "title": "LLM Voice: Delete Inbox Message",
        "category": "LLM Voice",
        "icon": "$(trash)"
      },
      {
        "command": "llmVoice.inbox.markRead",
        "title": "LLM Voice: Toggle Inbox Message Read",
        "category": "LLM Voice",
        "icon": "$(check)"
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "llm-voice-panel",
          "title": "LLM Voice",
          "icon": "media/player-icon.svg"
        }
      ],
      "activitybar": [
        {
          "id": "llm-voice-explorer",
          "title": "LLM Voice",
          "icon": "media/player-icon.svg"
        }
      ]
    },
    "views": {
      "llm-voice-panel": [
        {
          "type": "webview",
          "id": "llmVoice.player",
          "name": "Player"
        }
      ],
      "llm-voice-explorer": [
        {
          "id": "llmVoice.inboxView",
          "name": "Inbox",
          "when": "config.llmVoice.ui.layout == full"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "llmVoice.player",
        "contents": "Aucune lecture en cours.\n[Choisir une voix](command:llmVoice.setupVoice)\n[Lire le document actuel](command:llmVoice.speakDocument)"
      },
      {
        "view": "llmVoice.inboxView",
        "contents": "Aucune réponse capturée.\n[Connecter Claude Code](command:llmVoice.installClaudeHook)"
      }
    ],
    "submenus": [
      {
        "id": "llmVoice.markdownContextMenu",
        "label": "LLM Voice"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "llmVoice.statusBar.openMenu",
          "when": "false"
        },
        {
          "command": "llmVoice.walkthroughOpenExample",
          "when": "false"
        },
        {
          "command": "llmVoice.inbox.speak",
          "when": "false"
        },
        {
          "command": "llmVoice.inbox.openFull",
          "when": "false"
        },
        {
          "command": "llmVoice.inbox.delete",
          "when": "false"
        },
        {
          "command": "llmVoice.inbox.markRead",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "submenu": "llmVoice.markdownContextMenu",
          "when": "resourceLangId == markdown",
          "group": "llmVoice"
        }
      ],
      "llmVoice.markdownContextMenu": [
        {
          "command": "llmVoice.speakSelection",
          "when": "resourceLangId == markdown && editorHasSelection",
          "group": "1_speak@1"
        },
        {
          "command": "llmVoice.speakFromCursor",
          "when": "resourceLangId == markdown",
          "group": "1_speak@2"
        },
        {
          "command": "llmVoice.speakSection",
          "when": "resourceLangId == markdown",
          "group": "1_speak@3"
        },
        {
          "command": "llmVoice.speakDocument",
          "when": "resourceLangId == markdown",
          "group": "1_speak@4"
        }
      ],
      "editor/title": [
        {
          "command": "llmVoice.speakDocument",
          "when": "resourceLangId == markdown",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "llmVoice.inbox.refresh",
          "when": "view == llmVoice.inboxView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "llmVoice.inbox.speak",
          "when": "view == llmVoice.inboxView && viewItem == llmVoiceInboxEntry",
          "group": "inline@1"
        },
        {
          "command": "llmVoice.inbox.openFull",
          "when": "view == llmVoice.inboxView && viewItem == llmVoiceInboxEntry",
          "group": "inline@2"
        },
        {
          "command": "llmVoice.inbox.markRead",
          "when": "view == llmVoice.inboxView && viewItem == llmVoiceInboxEntry",
          "group": "inline@3"
        },
        {
          "command": "llmVoice.inbox.delete",
          "when": "view == llmVoice.inboxView && viewItem == llmVoiceInboxEntry",
          "group": "inline@4"
        }
      ]
    },
    "keybindings": [
      {
        "key": "ctrl+alt+v d",
        "command": "llmVoice.speakDocument",
        "when": "editorTextFocus && !terminalFocus"
      },
      {
        "key": "ctrl+alt+v s",
        "command": "llmVoice.speakSelection",
        "when": "editorTextFocus && editorHasSelection && !terminalFocus"
      },
      {
        "key": "ctrl+alt+v c",
        "command": "llmVoice.speakClipboard",
        "when": "!terminalFocus"
      },
      {
        "key": "ctrl+alt+v space",
        "command": "llmVoice.playPause",
        "when": "!terminalFocus"
      },
      {
        "key": "ctrl+alt+v x",
        "command": "llmVoice.stop",
        "when": "!terminalFocus"
      },
      {
        "key": "ctrl+alt+v n",
        "command": "llmVoice.nextSegment",
        "when": "!terminalFocus"
      },
      {
        "key": "ctrl+alt+v p",
        "command": "llmVoice.previousSegment",
        "when": "!terminalFocus"
      }
    ],
    "configuration": {
      "title": "LLM Voice",
      "properties": {
        "llmVoice.defaultProfile": {
          "type": "string",
          "default": "",
          "description": "Identifiant du profil utilisé par défaut pour une nouvelle session de lecture."
        },
        "llmVoice.profiles.bySource": {
          "type": "object",
          "default": {
            "claude-code": "llm-summary"
          },
          "description": "Profil par défaut selon la source de capture (CdC §47) : markdown, text (sélection), clipboard, claude-code. Une source non renseignée utilise le dernier profil sélectionné. Ex. par défaut : Claude Inbox → Résumé LLM.",
          "properties": {
            "markdown": {
              "type": "string",
              "description": "Profil par défaut pour un document Markdown."
            },
            "text": {
              "type": "string",
              "description": "Profil par défaut pour une sélection de texte."
            },
            "clipboard": {
              "type": "string",
              "description": "Profil par défaut pour le presse-papiers."
            },
            "claude-code": {
              "type": "string",
              "description": "Profil par défaut pour l'inbox Claude Code."
            }
          },
          "additionalProperties": false
        },
        "llmVoice.testVoice.text": {
          "type": "string",
          "default": "Bonjour. Voici un exemple de ma voix. Nous allons maintenant examiner un concept technique et voir comment l'expliquer clairement.",
          "description": "Texte de référence lu par « LLM Voice: Test Voice » (CdC §50)."
        },
        "llmVoice.tts.baseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8004",
          "description": "URL de base du service de synthèse vocale (TTS), doit rester locale par défaut (D2, D10). Port 8004 = Chatterbox (ADR-009 niveau 1)."
        },
        "llmVoice.tts.provider": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "chatterbox",
            "kokoro",
            "piper-local",
            "system",
            "openai-compatible"
          ],
          "enumDescriptions": [
            "Sélection automatique (S7.1, ADR-009) : Chatterbox si disponible, sinon Piper local, sinon la voix système — zéro configuration.",
            "Chatterbox (niveau 1, GPU, port 8004 par défaut).",
            "Kokoro (niveau 1, repli léger).",
            "Piper derrière un serveur compatible OpenAI (niveau 1b, port 5000 par défaut).",
            "Voix système sans installation ni serveur — espeak-ng/Piper local/say/SAPI selon la plateforme (niveau 1b, ADR-009).",
            "Point de terminaison compatible OpenAI générique (entreprise/cloud, niveaux 2-3)."
          ],
          "description": "Identifiant du provider TTS utilisé (provider agnostic, CdC §3.3). « auto » (défaut) ne nécessite aucune installation. Voir docs/providers.md."
        },
        "llmVoice.narrator.provider": {
          "type": "string",
          "default": "",
          "description": "Identifiant du provider de narration (LLM local), vide = lecture fidèle uniquement."
        },
        "llmVoice.narrator.baseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:11434",
          "description": "URL de base du service de narration (LLM local, ex. Ollama)."
        },
        "llmVoice.narrator.model": {
          "type": "string",
          "default": "qwen2.5:7b",
          "description": "Nom du modèle utilisé par le provider de narration (défaut : qwen2.5:7b, un compromis raisonnable taille/fiabilité en sortie structurée avec Ollama, CdC §21)."
        },
        "llmVoice.narrator.timeoutMs": {
          "type": "number",
          "default": 60000,
          "minimum": 1000,
          "description": "Délai maximal (ms) d'une requête de narration avant annulation, combiné au signal utilisateur (Stop). CdC §52/résilience."
        },
        "llmVoice.tts.timeoutMs": {
          "type": "number",
          "default": 60000,
          "minimum": 1000,
          "description": "Délai maximal (ms) d'une requête de synthèse vocale avant annulation, combiné au signal utilisateur (Stop). CdC §52/résilience."
        },
        "llmVoice.tts.readyTimeoutMs": {
          "type": "number",
          "default": 30000,
          "minimum": 0,
          "description": "Délai maximal (ms) d'attente d'un provider TTS en statut « Loading » (CdC §51) avant la première synthèse, plutôt que d'échouer immédiatement. 0 = aucune attente."
        },
        "llmVoice.audio.maxRetries": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "description": "Nombre de nouvelles tentatives avant qu'un chunk audio invalide déclenche le choix Skip / Stop (CdC §52)."
        },
        "llmVoice.audio.prefetchChunks": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "maximum": 10,
          "description": "Nombre de chunks audio pré-synthétisés en avance (CdC §32). 2 convient tant que le facteur temps réel (RTF) du provider TTS reste ≈ 1 — voir docs/performance.md."
        },
        "llmVoice.audio.firstChunkSentences": {
          "type": "number",
          "default": 1,
          "minimum": 1,
          "maximum": 10,
          "description": "Nombre de phrases du tout premier chunk audio d'un document, avant la taille normale du profil (CdC §63 : la lecture doit démarrer dès le premier chunk). Sans effet si ≥ à la taille de chunk du profil."
        },
        "llmVoice.tts.warmup": {
          "type": "boolean",
          "default": true,
          "description": "Préchauffe le provider TTS (health() + courte synthèse jetable) dès la première résolution du provider, en tâche de fond, pour absorber le cold start (compilation GPU) hors du chemin critique d'une vraie lecture."
        },
        "llmVoice.highlight.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Active le surlignage du segment en cours de lecture dans l'éditeur (ADR-002)."
        },
        "llmVoice.highlight.mode": {
          "type": "string",
          "enum": [
            "sentence",
            "block"
          ],
          "default": "sentence",
          "description": "Granularité du surlignage : phrase (lecture fidèle) ou bloc (narration transformée, CdC §15)."
        },
        "llmVoice.codeLens.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Affiche un CodeLens « ▶ Lire cette section » au-dessus de chaque titre Markdown (CdC §69)."
        },
        "llmVoice.cache.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Active le cache disque des fichiers audio synthétisés."
        },
        "llmVoice.cache.maxSizeMb": {
          "type": "number",
          "default": 512,
          "minimum": 0,
          "description": "Taille maximale du cache audio en mégaoctets."
        },
        "llmVoice.claude.inboxPath": {
          "type": "string",
          "default": "",
          "description": "Chemin de l'inbox recevant les réponses de Claude Code capturées par le hook Stop."
        },
        "llmVoice.claude.captureEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Active la capture automatique des réponses Claude Code via le hook Stop."
        },
        "llmVoice.privacy.localOnly": {
          "type": "boolean",
          "default": true,
          "description": "N'autorise que des providers locaux (loopback) ; toute cible réseau distante est refusée (D10, ADR-009)."
        },
        "llmVoice.network.trustedHosts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Hôtes explicitement autorisés lorsque `privacy.localOnly` est désactivé."
        },
        "llmVoice.ui.layout": {
          "type": "string",
          "enum": [
            "minimal",
            "full"
          ],
          "default": "minimal",
          "description": "`minimal` (défaut) : status bar + Panel + CodeLens. `full` : View Container complet (ADR-011)."
        },
        "llmVoice.privacy.telemetryEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Active la télémétrie d'usage. Désactivée par défaut."
        },
        "llmVoice.log.level": {
          "type": "string",
          "enum": [
            "error",
            "warn",
            "info",
            "debug"
          ],
          "default": "info",
          "description": "Niveau de journalisation de l'Output Channel « LLM Voice » (CdC §81). Aucun niveau ne journalise de clé API, contenu de document, réponse Claude ou audio (AC-SEC-07)."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "llmVoice.gettingStarted",
        "title": "Démarrer avec LLM Voice",
        "description": "Lisez vos documents Markdown et les réponses de vos agents LLM à voix haute, 100 % en local — quatre étapes pour être opérationnel.",
        "steps": [
          {
            "id": "chooseVoice",
            "title": "Choisir une voix",
            "description": "LLM Voice fonctionne dès l'installation avec la voix de votre système, sans rien installer. Si aucune voix locale n'est encore installée, le premier « Speak » propose de télécharger la voix française autonome (~60 Mo, une fois, aucun Docker). Le niveau « Qualité maximale » (clonage de voix) reste disponible en option, mais nécessite Docker.\n[Choisir une voix](command:llmVoice.setupVoice)",
            "media": {
              "image": "media/walkthrough/choose-voice.svg",
              "altText": "Trois niveaux de voix : système, Piper, Chatterbox"
            },
            "completionEvents": [
              "onCommand:llmVoice.setupVoice"
            ]
          },
          {
            "id": "readDocument",
            "title": "Lire un document",
            "description": "Ouvrez un fichier Markdown et lancez la lecture : le segment en cours de lecture est surligné dans l'éditeur, et les contrôles de lecture apparaissent dans le mini-player.\n[Ouvrir l'exemple et lire](command:llmVoice.walkthroughOpenExample)",
            "media": {
              "image": "media/walkthrough/read-document.svg",
              "altText": "Un document Markdown lu à voix haute, segment surligné"
            },
            "completionEvents": [
              "onCommand:llmVoice.speakDocument"
            ]
          },
          {
            "id": "chooseProfile",
            "title": "Choisir un profil",
            "description": "Un profil fixe la voix, le provider TTS et le narrateur. Quatre profils sont fournis par défaut : Lecture fidèle, Professeur technique, Résumé LLM, Révision rapide.\n[Choisir un profil](command:llmVoice.selectProfile)",
            "media": {
              "image": "media/walkthrough/choose-profile.svg",
              "altText": "Quatre profils de lecture au choix"
            },
            "completionEvents": [
              "onCommand:llmVoice.selectProfile"
            ]
          },
          {
            "id": "connectClaude",
            "title": "Optionnel : connecter Claude Code",
            "description": "Capturez automatiquement les réponses de Claude Code dans une inbox dédiée, et écoutez-les au lieu de les lire.\n[Connecter Claude Code](command:llmVoice.installClaudeHook)",
            "media": {
              "image": "media/walkthrough/connect-claude.svg",
              "altText": "Réponses de Claude Code capturées dans une inbox"
            },
            "completionEvents": [
              "onCommand:llmVoice.installClaudeHook"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./ --noEmit false --outDir out",
    "watch": "tsc -p ./ --watch",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p ./ --noEmit",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration-real": "vitest run --config vitest.integration-real.config.ts",
    "test:integration-security": "npm run build && vscode-test --label integration-security",
    "bundle": "node scripts/esbuild.mjs",
    "generate:icon": "node scripts/generate-icon.mjs",
    "generate:profile-schema": "node scripts/generate-profile-schema.mjs",
    "gen:schema": "npm run generate:profile-schema",
    "copy:claude-integration": "node scripts/copy-claude-integration.mjs",
    "sync:changelog": "node scripts/sync-changelog.mjs",
    "build": "npm run compile && npm run generate:profile-schema && npm run copy:claude-integration && npm run bundle",
    "test:integration": "npm run build && vscode-test",
    "package": "npm run generate:icon && npm run sync:changelog && npm run build && vsce package --no-dependencies -o llm-voice.vsix",
    "vscode:prepublish": "npm run build",
    "check:audit": "npm audit --omit=dev --audit-level=high",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:vsix": "npm run build && node scripts/check-vsix.mjs",
    "check:security": "npm run check:audit && npm run check:licenses && npm run check:vsix"
  },
  "dependencies": {
    "mdast-util-to-string": "^4.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.2",
    "@types/unist": "^3.0.3",
    "@types/vscode": "^1.95.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitest/coverage-v8": "^2.1.8",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
