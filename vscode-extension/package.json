{
  "name": "llm-voice",
  "displayName": "LLM Voice",
  "description": "Local-first voice narration for Markdown documents and LLM agent output (Claude Code, and more).",
  "version": "0.1.0",
  "publisher": "guilhem-bonnet",
  "license": "MIT",
  "private": true,
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Guilhem-Bonnet/llm-voice.git",
    "directory": "vscode-extension"
  },
  "engines": {
    "vscode": "^1.95.0",
    "node": ">=22"
  },
  "extensionKind": [
    "ui"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "jsonValidation": [
      {
        "fileMatch": "profiles.json",
        "url": "./schemas/profile-collection.schema.json"
      }
    ],
    "commands": [
      { "command": "llmVoice.speakDocument", "title": "LLM Voice: Speak Document", "category": "LLM Voice" },
      { "command": "llmVoice.speakSelection", "title": "LLM Voice: Speak Selection", "category": "LLM Voice" },
      { "command": "llmVoice.speakFromCursor", "title": "LLM Voice: Speak From Cursor", "category": "LLM Voice" },
      { "command": "llmVoice.speakSection", "title": "LLM Voice: Speak Section", "category": "LLM Voice" },
      { "command": "llmVoice.speakClipboard", "title": "LLM Voice: Speak Clipboard", "category": "LLM Voice" },
      { "command": "llmVoice.play", "title": "LLM Voice: Play", "category": "LLM Voice" },
      { "command": "llmVoice.pause", "title": "LLM Voice: Pause", "category": "LLM Voice" },
      { "command": "llmVoice.stop", "title": "LLM Voice: Stop", "category": "LLM Voice" },
      { "command": "llmVoice.previousSegment", "title": "LLM Voice: Previous Segment", "category": "LLM Voice" },
      { "command": "llmVoice.nextSegment", "title": "LLM Voice: Next Segment", "category": "LLM Voice" },
      { "command": "llmVoice.selectProfile", "title": "LLM Voice: Select Profile", "category": "LLM Voice" },
      { "command": "llmVoice.openProfiles", "title": "LLM Voice: Open Profiles", "category": "LLM Voice" },
      { "command": "llmVoice.openInbox", "title": "LLM Voice: Open Inbox", "category": "LLM Voice" },
      { "command": "llmVoice.speakLatestClaudeResponse", "title": "LLM Voice: Speak Latest Claude Response", "category": "LLM Voice" },
      { "command": "llmVoice.clearHighlight", "title": "LLM Voice: Clear Highlight", "category": "LLM Voice" },
      { "command": "llmVoice.clearAudioCache", "title": "LLM Voice: Clear Audio Cache", "category": "LLM Voice" },
      { "command": "llmVoice.verifyLocalMode", "title": "LLM Voice: Verify Local Mode", "category": "LLM Voice" },
      { "command": "llmVoice.installClaudeHook", "title": "LLM Voice: Install Claude Hook", "category": "LLM Voice" },
      { "command": "llmVoice.uninstallClaudeHook", "title": "LLM Voice: Uninstall Claude Hook", "category": "LLM Voice" },
      { "command": "llmVoice.statusBar.openMenu", "title": "LLM Voice: Status Bar Menu", "category": "LLM Voice" },
      { "command": "llmVoice.inbox.refresh", "title": "LLM Voice: Refresh Inbox", "category": "LLM Voice", "icon": "$(refresh)" },
      { "command": "llmVoice.inbox.speak", "title": "LLM Voice: Speak Inbox Message", "category": "LLM Voice", "icon": "$(play)" },
      { "command": "llmVoice.inbox.openFull", "title": "LLM Voice: Open Full Response", "category": "LLM Voice", "icon": "$(eye)" },
      { "command": "llmVoice.inbox.delete", "title": "LLM Voice: Delete Inbox Message", "category": "LLM Voice", "icon": "$(trash)" },
      { "command": "llmVoice.inbox.markRead", "title": "LLM Voice: Toggle Inbox Message Read", "category": "LLM Voice", "icon": "$(check)" }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "llm-voice-panel",
          "title": "LLM Voice",
          "icon": "media/player-icon.svg"
        }
      ],
      "activitybar": [
        {
          "id": "llm-voice-explorer",
          "title": "LLM Voice",
          "icon": "media/player-icon.svg"
        }
      ]
    },
    "views": {
      "llm-voice-panel": [
        {
          "type": "webview",
          "id": "llmVoice.player",
          "name": "Player"
        }
      ],
      "llm-voice-explorer": [
        {
          "id": "llmVoice.inboxView",
          "name": "Inbox",
          "when": "config.llmVoice.ui.layout == full"
        }
      ]
    },
    "submenus": [
      { "id": "llmVoice.markdownContextMenu", "label": "LLM Voice" }
    ],
    "menus": {
      "commandPalette": [
        { "command": "llmVoice.statusBar.openMenu", "when": "false" },
        { "command": "llmVoice.inbox.speak", "when": "false" },
        { "command": "llmVoice.inbox.openFull", "when": "false" },
        { "command": "llmVoice.inbox.delete", "when": "false" },
        { "command": "llmVoice.inbox.markRead", "when": "false" }
      ],
      "editor/context": [
        { "submenu": "llmVoice.markdownContextMenu", "when": "resourceLangId == markdown", "group": "llmVoice" }
      ],
      "llmVoice.markdownContextMenu": [
        { "command": "llmVoice.speakSelection", "when": "resourceLangId == markdown && editorHasSelection", "group": "1_speak@1" },
        { "command": "llmVoice.speakFromCursor", "when": "resourceLangId == markdown", "group": "1_speak@2" },
        { "command": "llmVoice.speakSection", "when": "resourceLangId == markdown", "group": "1_speak@3" },
        { "command": "llmVoice.speakDocument", "when": "resourceLangId == markdown", "group": "1_speak@4" }
      ],
      "view/title": [
        { "command": "llmVoice.inbox.refresh", "when": "view == llmVoice.inboxView", "group": "navigation" }
      ],
      "view/item/context": [
        { "command": "llmVoice.inbox.speak", "when": "view == llmVoice.inboxView && viewItem == llmVoiceInboxEntry", "group": "inline@1" },
        { "command": "llmVoice.inbox.openFull", "when": "view == llmVoice.inboxView && viewItem == llmVoiceInboxEntry", "group": "inline@2" },
        { "command": "llmVoice.inbox.markRead", "when": "view == llmVoice.inboxView && viewItem == llmVoiceInboxEntry", "group": "inline@3" },
        { "command": "llmVoice.inbox.delete", "when": "view == llmVoice.inboxView && viewItem == llmVoiceInboxEntry", "group": "inline@4" }
      ]
    },
    "keybindings": [
      { "key": "ctrl+alt+v d", "command": "llmVoice.speakDocument" },
      { "key": "ctrl+alt+v s", "command": "llmVoice.speakSelection", "when": "editorHasSelection" },
      { "key": "ctrl+alt+v c", "command": "llmVoice.speakClipboard" },
      { "key": "ctrl+alt+v space", "command": "llmVoice.play" },
      { "key": "ctrl+alt+v x", "command": "llmVoice.stop" },
      { "key": "ctrl+alt+v n", "command": "llmVoice.nextSegment" },
      { "key": "ctrl+alt+v p", "command": "llmVoice.previousSegment" }
    ],
    "configuration": {
      "title": "LLM Voice",
      "properties": {
        "llmVoice.defaultProfile": {
          "type": "string",
          "default": "",
          "description": "Identifiant du profil utilisé par défaut pour une nouvelle session de lecture."
        },
        "llmVoice.tts.baseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8004",
          "description": "URL de base du service de synthèse vocale (TTS), doit rester locale par défaut (D2, D10). Port 8004 = Chatterbox (ADR-009 niveau 1)."
        },
        "llmVoice.tts.provider": {
          "type": "string",
          "default": "chatterbox",
          "enum": ["chatterbox", "kokoro", "openai-compatible"],
          "description": "Identifiant du provider TTS utilisé (provider agnostic, CdC §3.3). Voir docs/providers.md."
        },
        "llmVoice.narrator.provider": {
          "type": "string",
          "default": "",
          "description": "Identifiant du provider de narration (LLM local), vide = lecture fidèle uniquement."
        },
        "llmVoice.narrator.baseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:11434",
          "description": "URL de base du service de narration (LLM local, ex. Ollama)."
        },
        "llmVoice.narrator.model": {
          "type": "string",
          "default": "qwen2.5:7b",
          "description": "Nom du modèle utilisé par le provider de narration (défaut : qwen2.5:7b, un compromis raisonnable taille/fiabilité en sortie structurée avec Ollama, CdC §21)."
        },
        "llmVoice.audio.prefetchChunks": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "maximum": 10,
          "description": "Nombre de chunks audio pré-synthétisés en avance (CdC §32)."
        },
        "llmVoice.highlight.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Active le surlignage du segment en cours de lecture dans l'éditeur (ADR-002)."
        },
        "llmVoice.highlight.mode": {
          "type": "string",
          "enum": ["sentence", "block"],
          "default": "sentence",
          "description": "Granularité du surlignage : phrase (lecture fidèle) ou bloc (narration transformée, CdC §15)."
        },
        "llmVoice.codeLens.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Affiche un CodeLens « ▶ Lire cette section » au-dessus de chaque titre Markdown (CdC §69)."
        },
        "llmVoice.cache.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Active le cache disque des fichiers audio synthétisés."
        },
        "llmVoice.cache.maxSizeMb": {
          "type": "number",
          "default": 512,
          "minimum": 0,
          "description": "Taille maximale du cache audio en mégaoctets."
        },
        "llmVoice.claude.inboxPath": {
          "type": "string",
          "default": "",
          "description": "Chemin de l'inbox recevant les réponses de Claude Code capturées par le hook Stop."
        },
        "llmVoice.claude.captureEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Active la capture automatique des réponses Claude Code via le hook Stop."
        },
        "llmVoice.profiles.bySource": {
          "type": "object",
          "default": { "claude-code": "llm-summary" },
          "description": "Profil par défaut selon la source du texte (CdC §47), ex. { \"claude-code\": \"llm-summary\" }. Utilisé par « Speak Latest Claude Response »."
        },
        "llmVoice.privacy.localOnly": {
          "type": "boolean",
          "default": true,
          "description": "N'autorise que des providers locaux (loopback) ; toute cible réseau distante est refusée (D10, ADR-009)."
        },
        "llmVoice.network.trustedHosts": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Hôtes explicitement autorisés lorsque `privacy.localOnly` est désactivé."
        },
        "llmVoice.ui.layout": {
          "type": "string",
          "enum": ["minimal", "full"],
          "default": "minimal",
          "description": "`minimal` (défaut) : status bar + Panel + CodeLens. `full` : View Container complet (ADR-011)."
        },
        "llmVoice.privacy.telemetryEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Active la télémétrie d'usage. Désactivée par défaut."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./ --noEmit false --outDir out",
    "watch": "tsc -p ./ --watch",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p ./ --noEmit",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration-real": "vitest run --config vitest.integration-real.config.ts",
    "bundle": "node scripts/esbuild.mjs",
    "generate:icon": "node scripts/generate-icon.mjs",
    "generate:profile-schema": "node scripts/generate-profile-schema.mjs",
    "copy:claude-integration": "node scripts/copy-claude-integration.mjs",
    "build": "npm run compile && npm run generate:profile-schema && npm run copy:claude-integration && npm run bundle",
    "test:integration": "npm run build && vscode-test",
    "package": "npm run generate:icon && npm run build && vsce package --no-dependencies -o llm-voice.vsix",
    "vscode:prepublish": "npm run build"
  },
  "dependencies": {
    "mdast-util-to-string": "^4.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.2",
    "@types/unist": "^3.0.3",
    "@types/vscode": "^1.95.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitest/coverage-v8": "^2.1.8",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
