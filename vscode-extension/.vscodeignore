# What must never reach a user's disk (S6.1 audit, axis 6).
# `scripts/check-vsix.mjs` asserts the resulting file list; keep the two in
# sync — this file is allow-by-default, so anything new that is not listed
# here ships.

# Test code and its fixtures — the fixtures carry hostile payloads on purpose.
test/**
.vscode-test/**
.vscode-test.mjs
coverage/**
.vitest/**

# Sources, intermediate builds and maps: `dist/extension.js` is what ships.
src/**
out/**
**/*.ts
**/*.map

# Build and tooling configuration, only meaningful in the repository.
scripts/**
tsconfig.json
vitest.config.ts
vitest.integration-real.config.ts
eslint.config.mjs
.eslintrc*
node_modules/**
package-lock.json
docs/**

# Repository/editor metadata.
.gitignore
.editorconfig
.nvmrc
.github/**
.vscode/**

# Anything that looks like a secret or a local environment.
.env
.env.*
.npmrc
**/*.pem
**/*.key
**/*.p12
**/*.pfx

# Grimoire framework artefacts: the tool-policy hook writes traces into the
# current working directory, so they appear here whenever npm runs from this
# folder. They must never ship in a published extension.
_grimoire-output/**
_grimoire/**
