{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "grimoire-hook --host claude --event SessionStart",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "grimoire-hook --host claude --event PreToolUse",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/.npmrc)",
      "Read(./**/.pypirc)",
      "Read(./**/id_rsa)",
      "Read(./**/id_ed25519)",
      "Read(./**/id_ecdsa)",
      "Read(./**/secret/**)",
      "Read(./**/secrets/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.p12)",
      "Read(./**/*.pfx)",
      "Read(./**/*.keystore)",
      "Read(./**/*.jks)",
      "Read(./**/credentials)",
      "Read(./**/credentials.json)",
      "Read(./**/credentials.yaml)",
      "Read(./**/credentials.yml)",
      "Read(./**/service-account*.json)"
    ],
    "ask": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(terraform destroy:*)",
      "Bash(kubectl delete:*)"
    ],
    "allow": [
      "Bash(grimoire:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ]
  }
}
