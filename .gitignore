# --- Grimoire Kit ---
# Session runs — ephemeral runtime data
_grimoire-output/.runs/
# Memory archives — compressed old sessions
_grimoire/_memory/archives/
# Internal agent telemetry — no secrets, no value for OSS contributors.
# planning-artifacts/ and evidence/ stay tracked (public ADRs, decisions, proofs).
_grimoire-output/traces/
_grimoire-output/events/

# --- Node / npm ---
node_modules/
npm-debug.log*

# --- Build outputs ---
out/
dist/
*.vsix
# Copied from integrations/claude-code/ at build time (npm run copy:claude-integration)
vscode-extension/resources/claude-code/
# vscode-extension/schemas/profile-collection.schema.json is committed
# (S5.2): `contributes.jsonValidation` in package.json references it by a
# relative path a fresh checkout must resolve without a build step first,
# and `test/unit/schemas/profile-collection.schema.test.ts` fails CI if it
# drifts from `src/core/profile.schema.ts` — regenerate with `npm run
# gen:schema` (alias of `generate:profile-schema`) and commit the result.

# --- Tests ---
.vscode-test/
coverage/

# --- Env / secrets ---
.env
.env.*
!.env.example

