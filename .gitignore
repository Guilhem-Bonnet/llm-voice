# --- Grimoire Kit ---
# Session runs — ephemeral runtime data
_grimoire-output/.runs/
# Memory archives — compressed old sessions
_grimoire/_memory/archives/
# Internal agent telemetry — no secrets, no value for OSS contributors.
# planning-artifacts/ and evidence/ stay tracked (public ADRs, decisions, proofs).
_grimoire-output/traces/
_grimoire-output/events/

# --- Node / npm ---
node_modules/
npm-debug.log*

# --- Build outputs ---
out/
dist/
*.vsix
# Staged Core release binary (ADR-012 §7, GAO-s1-fedora-pa-001) — rebuilt by
# `stage-core.mjs` from `target/release/`, never committed; still reaches
# the VSIX because `.vscodeignore` does not exclude it.
vscode-extension/bin/
# Copied from integrations/claude-code/ at build time (npm run copy:claude-integration)
vscode-extension/resources/claude-code/
# vscode-extension/schemas/profile-collection.schema.json is committed
# (S5.2): `contributes.jsonValidation` in package.json references it by a
# relative path a fresh checkout must resolve without a build step first,
# and `test/unit/schemas/profile-collection.schema.test.ts` fails CI if it
# drifts from `src/core/profile.schema.ts` — regenerate with `npm run
# gen:schema` (alias of `generate:profile-schema`) and commit the result.

# --- Tests ---
.vscode-test/
coverage/
.vitest/

# --- Env / secrets ---
.env
.env.*
!.env.example

_grimoire/_memory/grimoire_lexical.sqlite3
vscode-extension/_grimoire-output/

# Rust (Core, ADR-012)
/target/
# Traces Grimoire écrites quand un hook tourne depuis src/
vscode-extension/src/_grimoire-output/

# Banc d écoute : audio régénérable par scripts/voice-lab/run.sh
_grimoire-output/evidence/GAO-essais-voix-001/ecoute/wav/
_grimoire-output/evidence/GAO-essais-voix-001/ecoute/*.ogg
_grimoire-output/evidence/GAO-essais-voix-001/ecoute-france/wav/
_grimoire-output/evidence/GAO-essais-voix-001/ecoute-france/*.ogg
_grimoire-output/evidence/GAO-essais-voix-001/ecoute/index.html
_grimoire-output/evidence/GAO-essais-voix-001/ecoute-france/index.html
_grimoire-output/evidence/GAO-essais-voix-001/ecoute-narrateurs/wav/
_grimoire-output/evidence/GAO-essais-voix-001/ecoute-narrateurs/*.ogg
_grimoire-output/evidence/GAO-essais-voix-001/ecoute-narrateurs/index.html

# Banc Kyutai TTS 1.6B : audio régénérable par scripts/voice-lab/kyutai16.py
_grimoire-output/evidence/GAO-essais-voix-001/ecoute-kyutai16/wav/
_grimoire-output/evidence/GAO-essais-voix-001/ecoute-kyutai16/*.ogg
_grimoire-output/evidence/GAO-essais-voix-001/ecoute-kyutai16/index.html
_grimoire-output/evidence/GAO-essais-voix-001/ecoute-classique/wav/
_grimoire-output/evidence/GAO-essais-voix-001/ecoute-classique/*.ogg
_grimoire-output/evidence/GAO-essais-voix-001/ecoute-classique/index.html
