# syntax=docker/dockerfile:1
# Serveur Qwen3-TTS de LLM Voice, variante AMD ROCm 7.2.3 (prouvée sur RX 9070, gfx1201).
# Sans modèles ni voix : ils viennent de l'image llm-voice-qwen3-models (volumes nommés).
#   docker build -f deploy/qwen3/Dockerfile.rocm -t ghcr.io/guilhem-bonnet/llm-voice-qwen3:0.1.0-rocm deploy/qwen3
ARG BASE_IMAGE=ubuntu:22.04@sha256:f64b2ffc2f10ab8f8505aa56b2664bd846cbb9df87c7e2532e30f7667021c0e6
FROM ${BASE_IMAGE}

ARG VERSION=0.1.0
ARG ROCM_VERSION=7.2.3
LABEL org.opencontainers.image.title="llm-voice-qwen3" \
      org.opencontainers.image.description="Serveur local Qwen3-TTS de LLM Voice (voix figée, voix jouée, création de voix), AMD ROCm 7.2.3. Modèles et voix dans llm-voice-qwen3-models." \
      org.opencontainers.image.source="https://github.com/Guilhem-Bonnet/llm-voice" \
      org.opencontainers.image.licenses="MIT AND Apache-2.0" \
      org.opencontainers.image.version="${VERSION}-rocm" \
      io.llm-voice.gpu="rocm-${ROCM_VERSION}" \
      io.llm-voice.tested="oui : RX 9070 (gfx1201)"

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Bibliothèques ROCm d'exécution seulement (pas de rocm-dev, pas de compilateur) : celles que
# libtorch_hip.so des roues « lw » réclame (ldd), plus leurs dépendances.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl gnupg \
 && install -d -m 0755 /etc/apt/keyrings \
 && curl -fsSL https://repo.radeon.com/rocm/rocm.gpg.key | gpg --dearmor -o /etc/apt/keyrings/rocm.gpg \
 && echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/rocm.gpg] https://repo.radeon.com/rocm/apt/${ROCM_VERSION} jammy main" > /etc/apt/sources.list.d/rocm.list \
 && printf 'Package: *\nPin: release o=repo.radeon.com\nPin-Priority: 600\n' > /etc/apt/preferences.d/rocm-pin-600 \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
      python3.10 python3-pip \
      rocm-core hip-runtime-amd comgr hsa-rocr \
      rocblas hipblas hipblaslt rocfft hipfft rocrand hiprand \
      rocsolver hipsolver rocsparse hipsparse hipsparselt \
      miopen-hip rccl rocm-smi-lib roctracer \
 && apt-get purge -y curl gnupg \
 && apt-get autoremove -y \
 && rm -rf /var/lib/apt/lists/*
ENV LD_LIBRARY_PATH=/opt/rocm/lib

COPY requirements-rocm.txt requirements-common.txt /tmp/req/
RUN python3 -m pip install -r /tmp/req/requirements-rocm.txt
RUN python3 -m pip install -r /tmp/req/requirements-common.txt \
 && python3 -m pip install --no-deps qwen-tts==0.1.1 \
 && { python3 -m pip check || true; }

RUN useradd --uid 1000 --user-group --no-create-home --home-dir /tmp llm-voice \
 && install -d -o 1000 -g 1000 /lab /lab/hf /lab/refs /srv/qwen3
COPY server.py /srv/qwen3/server.py
# Le catalogue vient du volume des voix (image llm-voice-qwen3-models), pas de cette image.
RUN ln -s /lab/refs/voices.json /srv/qwen3/voices.json

ENV QWEN3_HOST=0.0.0.0 \
    QWEN3_REFS_DIR=/lab/refs \
    QWEN3_CREATED_DIR=/lab/refs/created \
    HF_HOME=/lab/hf \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    HF_HUB_DISABLE_TELEMETRY=1 \
    DO_NOT_TRACK=1 \
    HOME=/tmp \
    NUMBA_CACHE_DIR=/tmp/numba \
    ROCBLAS_USE_HIPBLASLT=0 \
    TORCH_ROCM_AOTRITON_ENABLE_EXPERIMENTAL=1 \
    MIOPEN_FIND_MODE=FAST
USER 1000:1000
WORKDIR /srv/qwen3
EXPOSE 8021
HEALTHCHECK --interval=15s --timeout=10s --start-period=20s --retries=4 \
  CMD ["python3", "-c", "import urllib.request as u; u.urlopen('http://127.0.0.1:8021/health', timeout=5)"]
ENTRYPOINT ["python3", "/srv/qwen3/server.py"]
