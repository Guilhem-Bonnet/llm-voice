# Copier en `.env` (même dossier que docker-compose.tts.yml) et ajuster.

# `getent group video render` sur la machine cible (GID observés Fedora 44 :
# video=39, render=105 ; peuvent différer sur Ubuntu/Arch).
LLM_VOICE_VIDEO_GID=39
LLM_VOICE_RENDER_GID=105

# 0 au premier lancement (téléchargement du modèle HF), 1 ensuite.
HF_HUB_OFFLINE=0

# auto (défaut GPU) | cpu (repli sans ROCm fonctionnel)
CHATTERBOX_DEVICE=auto
